<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="zadanie.App">
    <Application.Styles>
        <FluentTheme />

        
        <Style Selector="TextBlock, TextBox, Button, DataGrid, Window">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        </Style>
    </Application.Styles>
</Application>