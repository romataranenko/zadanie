<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="zadanie.App">
    <Application.Styles>
        <FluentTheme />

        <!-- Принудительно задаём шрифт с поддержкой кириллицы для всех элементов -->
        <Style Selector="TextBlock, TextBox, Button, DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, Microsoft Sans Serif" />
        </Style>

    </Application.Styles>
</Application>